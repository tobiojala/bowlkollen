# Supabase (required for the app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never use NEXT_PUBLIC_ prefix for this key
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Bowlkollen /admin operators (must match logged-in Supabase Auth users)
ADMIN_EMAILS=
# Optional: comma-separated Supabase user UUIDs
ADMIN_USER_IDS=

# Import scripts (scripts/import-bits-teams.ts) — rotate if previously committed to git
BITS_API_KEY=
BITS_COOKIE=
